<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CertificateViewer.Components.TrustStore"
             xmlns:dialogManager="clr-namespace:CertificateViewer.Components.DialogManager"
             x:DataType="vm:TrustStorePanel"
             x:Class="CertificateViewer.Components.TrustStore.TrustStorePanel"
             x:CompileBindings="True"
             Name="TrustStorePanelControl"
             dialogManager:DialogManager.Register="{Binding}">
    <Border>
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="16,0, 16,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <LucideIcon Kind="Store"
                                Size="24"
                                Foreground="{DynamicResource ForegroundLeadColor}" />

                    <TextBlock Classes="h4" Text="Trust Store" />
                </StackPanel>

            </Border>


            <StackPanel Margin="16" Spacing="16">
                <!-- Trust Status -->
                <Border IsVisible="{Binding IsChainValid}"
                        Background="{DynamicResource SuccessColor20}"
                        CornerRadius="8"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- <PathIcon Grid.Column="0" -->
                        <!--           Data="{StaticResource shield_check_regular}" -->
                        <!--           Foreground="#22C55E" /> -->
                        <LucideIcon Grid.Column="0"
                                    Kind="ShieldCheck"
                                    Size="24"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource SuccessColor}" />
                        <!-- <TextBlock -->
                        <!--     Grid.Column="0" Text="&#57855;" -->
                        <!--     FontSize="24" -->
                        <!--     Foreground="{DynamicResource SuccessColor}" -->
                        <!--     VerticalAlignment="Center" -->
                        <!--     FontFamily="{StaticResource Lucide}" /> -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Certificate is trusted"
                                       Classes="Large"
                                       Foreground="{DynamicResource SuccessColor}" />
                            <TextBlock Classes="Caption"
                                       Text="Valid chain found in store"
                                       Foreground="{DynamicResource SuccessColor}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border IsVisible="{CompiledBinding !#TrustStorePanelControl.IsChainValid}"
                        Background="{DynamicResource WarningColor20}"
                        CornerRadius="8"
                        Padding="12"
                        Name="BorderWarning">

                    <FlyoutBase.AttachedFlyout>
                        <Flyout>
                            <ItemsControl ItemsSource="{CompiledBinding #TrustStorePanelControl.Errors}" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <Grid ColumnDefinitions="Auto,*">
                        <LucideIcon Grid.Column="0"
                                    Kind="ShieldCheck"
                                    Size="24"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource WarningColor}" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Certificate is not trusted"
                                       Classes="Large"
                                       Foreground="{DynamicResource WarningColor}"
                                       FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="There were errors during validation"
                                           Classes="Caption"
                                           Foreground="{DynamicResource WarningColor}"
                                           VerticalAlignment="Center" />
                                <LucideIcon
                                    Kind="Info"
                                    Size="14"
                                    VerticalAlignment="Center"
                                    Margin="8,0"
                                    PointerEntered="InputElement_OnPointerEntered"
                                    Foreground="{DynamicResource WarningColor}" />

                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </Border>
                <!-- System Store Toggle -->
                <Border Background="{DynamicResource TabItemsBackgroundColor}"
                        CornerRadius="8"
                        Padding="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="System Trust Store"
                                       Foreground="{DynamicResource ForegroundColor}"
                                       FontWeight="Medium" />
                            <TextBlock Text="Use certificates from system trust store"
                                       Foreground="{DynamicResource ForegroundLeadColor}"
                                       FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding UseSystemStore}"
                                      OnContent=""
                                      OffContent="" />
                    </Grid>
                </Border>
                <!-- Trusted Certificates -->
                <StackPanel
                    IsVisible="{CompiledBinding !$parent[UserControl].((vm:TrustStorePanel)DataContext).UseSystemStore}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0"
                                   Classes="Large"
                                   VerticalAlignment="Center"
                                   Text="Custom Trusted Certificates" />
                        <Button Grid.Column="1"
                                Command="{CompiledBinding $parent[UserControl].((vm:TrustStorePanel)DataContext).AddRootCertificateCommand}">
                            <!-- IsVisible="{Binding CanAddSelectedCertificate}"> -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                <LucideIcon
                                    Kind="Plus"
                                    Size="20"
                                    VerticalAlignment="Center"
                                    Foreground="#2563EB" />
                                <TextBlock Text="Add Selected"
                                           VerticalAlignment="Center"
                                           Foreground="#2563EB" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TrustedCertificates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- <PathIcon Grid.Column="0" -->
                                        <!--           Data="{StaticResource shield_check_regular}" -->
                                        <!--           Foreground="#22C55E" /> -->
                                        <LucideIcon Grid.Column="0"
                                                    Kind="Plus"
                                                    Size="24"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SuccessColor}" />
                                        <!-- <TextBlock Grid.Column="0" Text="&#57855;" -->
                                        <!--            FontSize="24" -->
                                        <!--            Foreground="{DynamicResource SuccessColor}" -->
                                        <!--            FontFamily="{StaticResource Lucide}" /> -->
                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Subject}"
                                                       Classes="Caption"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Thumbprint}"
                                                       Classes="Muted"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Command="{Binding $parent[ItemsControl].((vm:TrustStorePanel)DataContext).RemoveFromTrustedStoreCommand}"
                                                CommandParameter="{Binding}"
                                                Foreground="{DynamicResource ErrorColor}"
                                                FontSize="24"
                                                Content="{LucideIconContent Trash2}">

                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No certificates in a custom trust store"
                               Classes="Muted"
                               HorizontalAlignment="Center"
                               Margin="0,16"
                               IsVisible="{Binding !TrustedCertificates.Count}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
