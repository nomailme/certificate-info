<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CertificateViewer.ViewModels"
             xmlns:converters="clr-namespace:CertificateViewer.Converters"
             xmlns:converters1="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
             xmlns:enums="using:CertificateViewer.Logic"
             x:Class="CertificateViewer.Components.CertificateDetails.CertificateDetailsPanel"
             x:DataType="vm:CertificateDetailsViewModel"
             x:CompileBindings="True">
    <UserControl.Resources>
        <converters:SubjectAlternativeNamesConverter x:Key="SubjectAlternativeNamesConverter" />
        <converters:CertificateRawConverter x:Key="CertificateRawConverter" />
        <converters:CertificateBase64Converter x:Key="CertificateBase64Converter" />
        <converters1:EnumToBoolConverter x:Key="EnumConverter"/>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="16,0, 16,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <LucideIcon Kind="Shield"
                                Size="24"
                                Foreground="{DynamicResource ForegroundLeadColor}" />
                    <TextBlock Classes="h4"
                               Text="Certificate Details" />
                </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{CompiledBinding ViewModes}"
                              SelectedItem="{CompiledBinding ViewMode, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Classes="h4">
                    </ComboBox>
            </Grid>
        </Border>

        <ScrollViewer DockPanel.Dock="Top"
                      IsVisible="{CompiledBinding ViewMode, Converter={StaticResource EnumConverter}, ConverterParameter={x:Static enums:ViewMode.General}}">
            <StackPanel Margin="16" Spacing="16">
                <StackPanel>
                    <TextBlock Text="Subject" Classes="Small" />
                    <TextBlock Classes="Caption"
                               Text="{CompiledBinding Certificate.Subject}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Issuer" Classes="Small" />
                    <TextBlock Classes="Caption"
                               Text="{CompiledBinding Certificate.Issuer}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Valid From" Classes="Small" />
                    <TextBlock Classes="Caption"
                               Text="{CompiledBinding Certificate.NotBefore}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Valid To" Classes="Small" />
                    <TextBlock Classes="Caption"
                               Text="{CompiledBinding Certificate.NotAfter}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Serial Number" Classes="Small" />
                    <TextBlock Classes="Caption"
                               Text="{CompiledBinding Certificate.SerialNumber}"
                               FontFamily="Cascadia Code"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Thumbprint" Classes="Small" />
                    <TextBlock Classes="Caption"
                               Text="{CompiledBinding Certificate.Thumbprint}"
                               FontFamily="Cascadia Code"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Subject Alternative Names" Classes="Small" />
                    <ListBox BorderBrush="{x:Null}"
                             ItemsSource="{CompiledBinding Path=Certificate, Converter={StaticResource SubjectAlternativeNamesConverter}}"
                             FontFamily="Cascadia Code"
                             Margin="0,4,0,0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="2" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer DockPanel.Dock="Bottom"
                      IsVisible="{CompiledBinding ViewMode, Converter={StaticResource EnumConverter}, ConverterParameter={x:Static enums:ViewMode.Raw}}">
            <SelectableTextBlock
                Margin="16"
                Classes="Caption"
                Text="{CompiledBinding Path=Certificate, Converter={StaticResource CertificateRawConverter}}" />
        </ScrollViewer>
        <ScrollViewer DockPanel.Dock="Bottom"
                      IsVisible="{CompiledBinding ViewMode, Converter={StaticResource EnumConverter}, ConverterParameter={x:Static enums:ViewMode.Base64}}">
            <SelectableTextBlock
                Margin="16 "
                FontFamily="Cascadia Code, Consolas, Ubuntu Mono, Menlo, Monaco, monospace"
                Classes="Small"
                FontSize="12"
                Text="{CompiledBinding Path=Certificate, Converter={StaticResource CertificateBase64Converter}}" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
