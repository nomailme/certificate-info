<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CertificateViewer.Components.Dialogs.PasswordBox.PasswordDialogContent">
    <StackPanel
        Width="275"
        Margin="24"
        Spacing="16">
        <TextBlock Classes="h4" Text="Enter password" />
        <TextBox
            shadUi:ControlAssist.Label="Password"
            shadUi:ElementAssist.FocusOnLoad="True"
            Classes="PasswordReveal"
            PasswordChar="•"
            Text="{Binding Password, Mode=TwoWay}"
            Watermark="Enter password"  />

        <StackPanel Margin="0,24,0,0" Spacing="16">
            <Button
                Classes="Primary"
                Command="{Binding SubmitCommand}"
                HotKey="Enter">
                Submit
            </Button>
            <Button
                Classes="Outline"
                Command="{Binding CancelCommand}"
                HotKey="Escape">
                Cancel
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>

