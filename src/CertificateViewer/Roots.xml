<linker>
  <!--
    Trim roots: the assembly-wide preserve="All" on CertificateViewer was removed in the
    MVVM extraction (no reflection surface remains in the app itself).

    The OpenUrl dialog content must be kept with its public constructor. ShadUI's
    DialogBuilder<T> resolves the content view from the view-model by naming convention
    (OpenUrlViewModel -> OpenUrlContent) and instantiates it via
    Activator.CreateInstance — a purely dynamic call the linker cannot see. Without this
    root the ctor is trimmed and the dialog throws MissingMethodException at runtime
    ("No parameterless constructor defined"). Verified against the trimmed publish
    (task: AOT-trim verification).
  -->
  <assembly fullname="CertificateViewer" include="OpenUrlContent" preserve="All" />
</linker>
