<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <!--
      ReactiveUI 23 annotates its expression-based WhenAny*/WhenActivated API with
      [RequiresUnreferencedCode], which surfaces as IL2026 trim warnings under the AOT
      (TrimMode=full) publish. These are false positives here: the view models are public,
      DI-registered and referenced by their views, so the properties the expressions touch
      are preserved by the trimmer. Suppress only this warning; keep the rest of the AOT
      analysis intact.
    -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
    <!-- Recommended Avalonia trimming settings for Native AOT -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <PublishTrimmed>true</PublishTrimmed>
    <AvaloniaXamlCompilation>true</AvaloniaXamlCompilation>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <StackTraceSupport>false</StackTraceSupport>
    <MetricsSupport>false</MetricsSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Lucide.Avalonia" Version="0.2.28" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="ShadUI" Version="0.2.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="Roots.xml"/>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CertificateViewer.Logic\CertificateViewer.Logic.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Dialogs\MessageBox.axaml"/>
    <UpToDateCheckInput Remove="Dialogs\OpenUrlWindow.axaml"/>
    <UpToDateCheckInput Remove="Dialogs\PasswordBox.axaml"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Components\CertificateDetails\CertificateDetailsPanel.axaml.cs">
      <DependentUpon>CertificateDetailsPanel.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Components\MainWindow2\MainWindow2.axaml.cs">
      <DependentUpon>MainWindow2.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Components\CertificateChain\CertificateChainPanel.axaml.cs">
      <DependentUpon>CertificateChainPanel.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Components\TrustStore\TrustStorePanel.axaml.cs">
      <DependentUpon>TrustStorePanel.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Components\Dialogs\OpenUrl\OpenUrlContent.axaml.cs">
      <DependentUpon>OpenUrlContent.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
